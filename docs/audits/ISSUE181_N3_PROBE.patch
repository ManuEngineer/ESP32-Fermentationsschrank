@@ -2,9 +2,55 @@
 
 #include <algorithm>
 
+#include <sys/time.h>
+#include <cerrno>
+#include <ctime>
+#include "esp_log.h"
 #include "esp_netif_sntp.h"
 #include "esp_sntp.h"
 
+
+// ---- N3 PROBE (Issue #181, nicht Produktcode, nicht committen) ----
+extern "C" void sntp_sync_time(struct timeval* tv) {
+    static const char* kP = "N3_PROBE";
+    struct timeval now;
+    gettimeofday(&now, nullptr);
+    const int64_t cpu = (int64_t)now.tv_sec * 1000000LL + now.tv_usec;
+    const int64_t srv = (int64_t)tv->tv_sec * 1000000LL + tv->tv_usec;
+    const int64_t delta = srv - cpu;
+    ESP_LOGW(kP, "sync_cb mode=%d time_before=%lld server=%lld delta_us=%lld",
+             (int)sntp_get_sync_mode(), (long long)now.tv_sec,
+             (long long)tv->tv_sec, (long long)delta);
+    if (sntp_get_sync_mode() == SNTP_SYNC_MODE_IMMED) {
+        const int r = settimeofday(tv, nullptr);
+        sntp_set_sync_status(SNTP_SYNC_STATUS_COMPLETED);
+        ESP_LOGW(kP, "IMMED settimeofday ret=%d", r);
+    } else {
+        struct timeval d = {(time_t)(delta / 1000000LL),
+                            (suseconds_t)(delta % 1000000LL)};
+        errno = 0;
+        const int r = adjtime(&d, nullptr);
+        const int e = errno;
+        struct timeval out = {0, 0};
+        const int r2 = adjtime(nullptr, &out);
+        ESP_LOGW(kP,
+                 "SMOOTH adjtime ret=%d errno=%d tv_sec_arg=%lld "
+                 "readback ret=%d remaining=%lld.%06ld",
+                 r, e, (long long)d.tv_sec, r2, (long long)out.tv_sec,
+                 (long)out.tv_usec);
+        if (r == -1) {
+            settimeofday(tv, nullptr);
+            sntp_set_sync_status(SNTP_SYNC_STATUS_COMPLETED);
+            ESP_LOGW(kP, "adjtime failed -> settimeofday fallback");
+        } else {
+            sntp_set_sync_status(SNTP_SYNC_STATUS_IN_PROGRESS);
+        }
+    }
+    struct timeval after;
+    gettimeofday(&after, nullptr);
+    ESP_LOGW(kP, "time_after=%lld", (long long)after.tv_sec);
+}
+
