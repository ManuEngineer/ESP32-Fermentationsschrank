+RunPersistenceResult RunPersistenceCoordinator::borrowedBusyResult() const {
+ auto r=result(RunPersistenceResultStatus::Busy); r.coordinatorState=RunPersistenceCoordinatorState::Busy; return r;
+}
+std::optional<RunPersistenceCoordinator::CommandOperation> RunPersistenceCoordinator::beginCommandOperation() {
+ if(commandBorrowed_ || state_==RunPersistenceCoordinatorState::Busy) return std::nullopt;
+ commandBorrowed_=true;
+ return CommandOperation{this};
+}
+RunCommandState* RunPersistenceCoordinator::commandCandidate(CommandOperation& op) {
+ if(op.owner_!=this || !commandBorrowed_) return nullptr;
+ return &workingSet_.candidate;
+}
+void RunPersistenceCoordinator::releaseCommandOperation() {
+ // Release dynamic children without constructing a full RunCommandState temporary.
+ clearActiveRunState(workingSet_.candidate);
+ std::string{}.swap(workingSet_.candidate.activeRunId);
+ commandBorrowed_=false;
+}
+RunPersistenceResult RunPersistenceCoordinator::persistBorrowedCommand(CommandOperation& op,
+ RunCommandState& current, const CommandDecisionView& d, const RunCheckpointTime& time,
+ const CrossRolePlausibilityContext* live, const FreshStartSnapshotProvenance* provenance) {
+ if(op.owner_!=this || !commandBorrowed_ || &d.before!=&current) return result(RunPersistenceResultStatus::InvalidDecision);
+ return persistCommandInternal(current,d,time,live,provenance);
+}
