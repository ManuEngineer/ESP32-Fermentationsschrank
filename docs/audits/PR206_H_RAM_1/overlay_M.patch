+namespace {
+// PR 206 H-RAM-1 measurement overlay M (non-merge): one compact resource line
+// before and after every shell and read-only status request, taken in the
+// httpd task. Only the path class is logged (never query, cookie, token or
+// body). `result` is the httpd send result; anything but 0 is an HTTP error.
+const char* hramPathClass(const char* uri) {
+    if (std::strcmp(uri, "/") == 0) return "shell";
+    if (std::strcmp(uri, "/api/v1/status") == 0) return "status";
+    if (std::strcmp(uri, "/api/v1/temperatures") == 0) return "temperatures";
+    if (std::strcmp(uri, "/api/v1/alerts") == 0) return "alerts";
+    return nullptr;
+}
+
+void logHramHttp(const char* phase, const char* pathClass, int result,
+                 std::size_t bodyBytes) {
+    ESP_LOGI("hram_http",
+             "phase=%s path=%s result=%d body=%u internal_free=%u "
+             "internal_min=%u internal_largest=%u httpd_stack_hwm=%u",
+             phase, pathClass, result, static_cast<unsigned>(bodyBytes),
+             static_cast<unsigned>(heap_caps_get_free_size(MALLOC_CAP_INTERNAL |
+                                                           MALLOC_CAP_8BIT)),
+             static_cast<unsigned>(heap_caps_get_minimum_free_size(
+                 MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT)),
+             static_cast<unsigned>(heap_caps_get_largest_free_block(
+                 MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT)),
+             static_cast<unsigned>(uxTaskGetStackHighWaterMark(nullptr)));
+}
+}  // namespace
+
 esp_err_t EspIdfHttpServerLifecycle::Impl::handleRequest(httpd_req_t* request) {
+    const char* const pathClass =
+        request != nullptr ? hramPathClass(request->uri) : nullptr;
+    if (pathClass != nullptr) logHramHttp("pre", pathClass, 0, 0U);
+    const esp_err_t result = handleRequestInner(request);
+    if (pathClass != nullptr) {
+        logHramHttp("sent", pathClass, static_cast<int>(result), 0U);
+    }
+    return result;
+}
+
+esp_err_t EspIdfHttpServerLifecycle::Impl::handleRequestInner(
+    httpd_req_t* request) {
     if (request == nullptr || request->user_ctx == nullptr) {
         return ESP_FAIL;
     }
