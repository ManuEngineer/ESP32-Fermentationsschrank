choice APP_ESP32_PROFILE
    prompt "ESP32 application profile"
    default APP_PROFILE_ESP32_BRINGUP
    help
        Waehlt genau eines der beiden ESP32-Produktionsprofile. Ohne
        explizites Release-Overlay bleibt Bring-up der sichere Default.
        Keine Option aktiviert reale Aktoren; das bleibt firmwarefest in
        main/CMakeLists.txt und include/app_config.hpp verankert
        (siehe docs/tasks/issue-74-implementation-plan.md, Abschnitt 7.2).

    config APP_PROFILE_ESP32_BRINGUP
        bool "ESP32 bring-up profile"

    config APP_PROFILE_ESP32_RELEASE
        bool "ESP32 release profile"

endchoice

config APP_ISSUE31_RENDERER_COMPARISON
    bool "Issue #31 renderer comparison runner"
    default n
    help
        Builds the explicit, actor-free Lean/LVGL comparison runner only.
        This is not enabled by either product profile and does not select a
        production renderer.

config APP_ISSUE31_LEAN_RUNNER
    bool "Issue #31 Lean-only representative screen runner"
    default n
    help
        Builds the explicit actor-free Lean-only representative screen runner
        for the Stage-4 comparison. This is not enabled by either product
        profile and does not select a production renderer.
