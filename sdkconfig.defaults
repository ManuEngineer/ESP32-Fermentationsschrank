# Reproduzierbare Startwerte fuer die ESP-IDF-6.1-Buildbasis (Issue #159).
# Kein Bring-up-/CI-/Release-Overlay: #72 besitzt noch keine reale
# funktionale Kconfig-Differenz zwischen diesen Stufen (siehe
# docs/tasks/issue-72-implementation-plan.md, Abschnitt 6).

# ESP32-WROOM-32E, passend zu platformio.ini board=esp32dev.
CONFIG_IDF_TARGET="esp32"

# Release 1 zielt auf exakt 4 MB Flash (siehe AGENTS.md, app_config.hpp).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Issue #90 production partition layout. The bring-up-only harness selects an
# alternative label for the same physical state-store flash range; it is not
# a physically separate test partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/issue_90_state_store.csv"

# Shared main-task allocation across profiles. Hardware evidence for Issue
# #164 found that 16 KiB cannot cover the synchronous local network-mode
# configuration preview/commit path through NVS.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# Keep the parser bound aligned with the closed Issue #27 DTO depth.
CONFIG_CJSON_NESTING_LIMIT=4

# Kein PSRAM-Eintrag: CONFIG_SPIRAM ist im ESP-IDF-Default bereits
# deaktiviert; Release 1 darf keine PSRAM-Abhaengigkeit einfuehren.
# Issue #31 raw-touch contract: conversion/calibration remains above the
# controller adapter boundary.
CONFIG_XPT2046_CONVERT_ADC_TO_COORDS=n

# Issue #164 SoftAP join QR uses the QR widget already included in the pinned
# LVGL component; no separate QR dependency or encoder is added.
CONFIG_LV_USE_QRCODE=y

# R1 RAM plan: size of the pinned LVGL builtin (TLSF) memory pool, a static
# internal-RAM array (no LV_MEM_POOL_ALLOC, LV_MEM_ADR=0). Reduced from the
# 65536 B default; measured peak use so far is 15856 B (about 24 % of the
# 63384 B usable pool). Shared by esp32_release and esp32_bringup. The free-heap
# gain is only claimed after the hardware re-measurement.
CONFIG_LV_MEM_SIZE=49152
